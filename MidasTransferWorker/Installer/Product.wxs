<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Package Name="Midas Transfer Worker"
           Manufacturer="MAM Software"
           Version="1.0.0.0"
           UpgradeCode="B8E1F2A4-3C5D-4E6F-9A0B-1C2D3E4F5A6B"
           Scope="perMachine"
           Compressed="yes">

    <!-- Cleanly remove any previously installed version on upgrade. -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />

    <MediaTemplate EmbedCab="yes" />

    <!-- Service account. Override at install time, e.g.:
         msiexec /i MidasTransferWorker.msi /qn SERVICEACCOUNT="DOMAIN\\svc" SERVICEPASSWORD="..." -->
    <Property Id="SERVICEACCOUNT" Value="LocalSystem" />
    <Property Id="SERVICEPASSWORD" Hidden="yes" />

    <!-- Install under Program Files (x86)\MAM Software\MidasTransferService to match the
         service's own Processed/Quarantine pathing (Environment.SpecialFolder.ProgramFilesX86). -->
    <StandardDirectory Id="ProgramFilesFolder">
      <Directory Id="MANUFACTURERFOLDER" Name="MAM Software">
        <Directory Id="MIDASFOLDER" Name="MidasTransferService" />
      </Directory>
    </StandardDirectory>

    <ComponentGroup Id="ServiceComponents" Directory="MIDASFOLDER">
      <!-- The service executable, its Windows Service registration, and EventLog source. -->
      <Component Id="ServiceExeComponent">
        <File Id="ServiceExeFile" Source="$(var.PublishedFolder)\MidasTransferWorker.exe" KeyPath="yes" />

        <ServiceInstall Id="ServiceInstaller"
                        Type="ownProcess"
                        Name="MidasTransferWorker"
                        DisplayName="Midas Transfer Worker"
                        Description="Automated Mavis XML SFTP transfer service"
                        Start="auto"
                        ErrorControl="normal"
                        Account="[SERVICEACCOUNT]"
                        Password="[SERVICEPASSWORD]" />

        <ServiceControl Id="ServiceControl"
                        Name="MidasTransferWorker"
                        Start="install"
                        Stop="both"
                        Remove="uninstall"
                        Wait="yes" />

        <!-- Pre-create a dedicated EventLog channel + source so the service (manageEventSource:false)
             can write to it. Using a non-standard Log name makes it appear in Event Viewer under
             "Applications and Services Logs" instead of the shared Application log. -->
        <util:EventSource Name="MidasTransferWorker"
                          Log="MidasTransferWorker"
                          EventMessageFile="%SystemRoot%\Microsoft.NET\Framework64\v4.0.30319\EventLogMessages.dll" />
      </Component>

      <!-- appsettings.json is installed with a stable component GUID and NeverOverwrite so that
           operator edits (e.g. environment-specific config) survive upgrades. -->
      <Component Id="AppSettingsComponent" Guid="C1D2E3F4-5A6B-7C8D-9E0F-1A2B3C4D5E6F" NeverOverwrite="yes">
        <File Id="AppSettingsFile" Source="$(var.PublishedFolder)\appsettings.json" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- Everything else from the publish output (runtime DLLs, etc.). WiX v4/v5 harvests the
         directory tree at build time, so no heat.exe step is required. The exe and appsettings
         are excluded because they are declared explicitly above. -->
    <ComponentGroup Id="PublishedFiles" Directory="MIDASFOLDER">
      <Files Include="$(var.PublishedFolder)\**">
        <Exclude Files="$(var.PublishedFolder)\MidasTransferWorker.exe" />
        <Exclude Files="$(var.PublishedFolder)\appsettings.json" />
      </Files>
    </ComponentGroup>

    <Feature Id="Main" Title="Midas Transfer Worker" Level="1">
      <ComponentGroupRef Id="ServiceComponents" />
      <ComponentGroupRef Id="PublishedFiles" />
    </Feature>

  </Package>
</Wix>
